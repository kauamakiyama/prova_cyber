{
  "manifest_version": 2,
  "name": "Privacy Guard",
  "version": "0.4.0",
  "description": "Detecta conexões a domínios de terceira parte, cookies injetados, armazenamento HTML5, bounce tracking e cookie sync durante a navegação.",

  "browser_specific_settings": {
    "gecko": {
      "id": "privacy-guard@insper.edu.br",
      "strict_min_version": "91.0"
    }
  },

  "permissions": [
    "webRequest",
    "tabs",
    "<all_urls>"
  ],

  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "web_accessible_resources": ["inject.js"],

  "browser_action": {
    "default_title": "Privacy Guard",
    "default_popup": "popup/popup.html"
  }
}
