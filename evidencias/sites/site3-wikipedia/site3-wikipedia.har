dClass(isScrollDown?'ext-discussiontools-init-new-topic-close':'ext-discussiontools-init-new-topic-open');setTimeout(()=>{$body.removeClass(['ext-discussiontools-init-new-topic-close','ext-discussiontools-init-new-topic-open']);$body.addClass(isScrollDown?'ext-discussiontools-init-new-topic-closed':'ext-discussiontools-init-new-topic-opened');\n},250);});}lastScrollTop=scrollTop;wasScrollDown=isScrollDown;},200));const observer=new IntersectionObserver(((entries)=>{$newTopicWrapper.toggleClass('ext-discussiontools-init-new-topic-pinned',entries[0].intersectionRatio===1);}),{threshold:[1]});observer.observe($newTopicWrapper[0]);}if($('.catlinks').filter('[data-mw-interface]').length||$('#page-secondary-actions').children().length||$('.return-link').length){$newTopicWrapper.addClass('ext-discussiontools-init-button-notFlush');}}mw.hook('discussionToolsOverflowMenuOnChoose').add((id,menuItem,threadItem)=>{if(id==='edit'){$(threadItem.getRange().commonAncestorContainer).closest('.ext-discussiontools-init-section').find('.mw-editsection > a').trigger('click');}});function closeLedeSectionDialog(){if(ledeSectionDialog&&ledeSectionDialog.isOpened()){return ledeSectionDialog.close().closed;}return $.Deferred().resolve();}module.exports={init:init,closeLedeSectionDialog:closeLedeSectionDialog};\n}}},{\"css\":[\".ext-discussiontools-ui-newTopic{clear:both}.ext-discussiontools-ui-newTopic.oo-ui-panelLayout-padded.oo-ui-panelLayout-framed{margin-top:2em}.ext-discussiontools-ui-newTopic .ext-discussiontools-ui-newTopic-notices{max-height:75vh;overflow:auto}.ext-discussiontools-ui-newTopic .ext-discussiontools-ui-newTopic-notices + .oo-ui-fieldLayout{margin-top:0}h2.ext-discussiontools-ui-newTopic-sectionTitle{max-width:none;padding:0;border:0;margin-top:4px}h2.ext-discussiontools-ui-newTopic-sectionTitle .oo-ui-inputWidget-input{line-height:3}.ext-discussiontools-ui-newTopic .ext-discussiontools-ui-replyWidget{margin-bottom:0}.ext-discussiontools-ui-newTopic .oo-ui-fieldLayout-messages{max-width:none}       .ext-discussiontools-init-highlight{position:absolute;pointer-events:none;opacity:0;mix-blend-mode:darken; transform:translateZ(0)}@media screen{html.skin-theme-clientpref-night .ext-discussiontools-init-highlight{mix-blend-mode:lighten}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .ext-discussiontools-init-highlight{mix-blend-mode:lighten}}.ext-discussiontools-init-highlight-fadein{opacity:1}.ext-discussiontools-init-highlight-fadeout{opacity:0;transition:opacity 250ms}.ext-discussiontools-init-publishedcomment{background-color:var(--background-color-success-subtle,#dff2eb)}.ext-discussiontools-init-targetcomment{background-color:var(--background-color-progressive-subtle,#e8eeff)}\"]},{\"cancel\":\"Cancelar\",\"discussiontools-autotopicsubpopup-body\":\"Receber\\u00e1 uma notifica\\u00e7\\u00e3o quando algu\\u00e9m publicar um coment\\u00e1rio novo nesta discuss\\u00e3o. Pode ajustar a sua configura\\u00e7\\u00e3o de notifica\\u00e7\\u00f5es nas prefer\\u00eancias.\",\"discussiontools-autotopicsubpopup-dismiss\":\"Entendido\",\"discussiontools-autotopicsubpopup-preferences\":\"Editar prefer\\u00eancias\",\"discussiontools-autotopicsubpopup-title\":\"Foi {{GENDER:|tornado subscritor|tornada subscritora}}\",\"discussiontools-error-comment-conflict\":\"N\\u00e3o foi poss\\u00edvel gravar o seu coment\\u00e1rio porque outra pessoa comentou ao mesmo tempo. Tente novamente, por favor, ou refresque a p\\u00e1gina para ver as \\u00faltimas interven\\u00e7\\u00f5es.\",\"discussiontools-error-comment-disappeared\":\"N\\u00e3o foi poss\\u00edvel encontrar o coment\\u00e1rio a que est\\u00e1 a responder na p\\u00e1gina. Este pode ter sido eliminado ou movido para outra p\\u00e1gina.\",\"discussiontools-error-comment-disappeared-reload\":\"Refresque a p\\u00e1gina, por favor, e tente novamente.\",\"discussiontools-error-comment-is-transcluded\":\"A hiperliga\\u00e7\\u00e3o \\\"{{int:discussiontools-replylink}}\\\" n\\u00e3o pode ser usada para responder a este coment\\u00e1rio. Para responder, use o editor de p\\u00e1gina inteira clicando \\\"$1\\\", por favor.\",\"discussiontools-error-comment-is-transcluded-title\":\"A hiperliga\\u00e7\\u00e3o \\\"{{int:discussiontools-replylink}}\\\" n\\u00e3o pode ser usada para responder a este coment\\u00e1rio porque ela \\u00e9 carregada de outra p\\u00e1gina. Para responder dirija-se a [[$1]], por favor.\",\"discussiontools-error-lint\":\"N\\u00e3o \\u00e9 poss\\u00edvel responder aos coment\\u00e1rios desta p\\u00e1gina devido a um erro no texto wiki. Pode saber mais sobre este erro [$1 lendo a documenta\\u00e7\\u00e3o], pedir ajuda [$2 publicando pedidos aqui] ou corrigir o problema [$3 abrindo o editor de p\\u00e1gina inteira].\",\"discussiontools-error-noswitchtove\":\"Desculpe, mas a mudan\\u00e7a para o modo visual est\\u00e1 desativada porque foi detetado <b>$1<\\/b> no coment\\u00e1rio que escreveu. [https:\\/\\/www.mediawiki.org\\/wiki\\/Special:MyLanguage\\/Help:DiscussionTools\\/Reply_tool_visual_mode_limitations Mais informa\\u00e7\\u00f5es].\",\"discussiontools-error-noswitchtove-extension\":\"sintaxe de extens\\u00f5es ou de refer\\u00eancias\",\"discussiontools-error-noswitchtove-table\":\"sintaxe de tabelas\",\"discussiontools-error-noswitchtove-template\":\"sintaxe de predefini\\u00e7\\u00f5es\",\"discussiontools-error-noswitchtove-title\":\"Modo visual desativado\",\"discussiontools-ledesection-title\":\"Sobre esta p\\u00e1gina de discuss\\u00e3o\",\"discussiontools-newtopic-missing-title\":\"Por favor, forne\\u00e7a um t\\u00edtulo para o {{GENDER:|seu}} t\\u00f3pico de discuss\\u00e3o\",\"discussiontools-newtopic-missing-title-prompt\":\"N\\u00e3o foi fornecido um t\\u00edtulo ao seu t\\u00f3pico de discuss\\u00e3o. Tem certeza de que deseja adicionar esse t\\u00f3pico sem um t\\u00edtulo?\",\"discussiontools-newtopic-placeholder-title\":\"Assunto\",\"discussiontools-newtopicssubscription-button-subscribe-label\":\"Subscrever\",\"discussiontools-newtopicssubscription-button-subscribe-tooltip\":\"Subscrever para receber notifica\\u00e7\\u00f5es quando forem iniciados t\\u00f3picos novos nesta p\\u00e1gina.\",\"discussiontools-newtopicssubscription-button-unsubscribe-label\":\"Anular subscri\\u00e7\\u00e3o\",\"discussiontools-newtopicssubscription-button-unsubscribe-tooltip\":\"Anular a subscri\\u00e7\\u00e3o para parar de receber notifica\\u00e7\\u00f5es quando forem iniciados t\\u00f3picos novos nesta p\\u00e1gina.\",\"discussiontools-newtopicssubscription-notify-subscribed-body\":\"Ir\\u00e1 receber notifica\\u00e7\\u00f5es quando forem iniciados t\\u00f3picos novos nesta p\\u00e1gina.\",\"discussiontools-newtopicssubscription-notify-subscribed-title\":\"T\\u00f3pico subscrito!\",\"discussiontools-newtopicssubscription-notify-unsubscribed-body\":\"Deixar\\u00e1 de receber notifica\\u00e7\\u00f5es quando forem iniciados t\\u00f3picos novos nesta p\\u00e1gina.\",\"discussiontools-newtopicssubscription-notify-unsubscribed-title\":\"Subscri\\u00e7\\u00e3o do t\\u00f3pico anulada.\",\"discussiontools-pagetitle-newtopic\":\"A come\\u00e7ar um novo t\\u00f3pico em $1\",\"discussiontools-pagetitle-reply\":\"A responder em $1\",\"discussiontools-permalink-button\":\"Copy link\",\"discussiontools-permalink-comment-copied\":\"Hiperliga\\u00e7\\u00e3o para o coment\\u00e1rio copiada para a \\u00e1rea de transfer\\u00eancia.\",\"discussiontools-postedit-confirmation-published\":\"O seu coment\\u00e1rio foi publicado.\",\"discussiontools-postedit-confirmation-topicadded\":\"O seu t\\u00f3pico foi adicionado.\",\"discussiontools-replylink\":\"{{GENDER:|responder}}\",\"discussiontools-replywidget-loading\":\"A carregar...\",\"discussiontools-replywidget-watchthis\":\"Adicionar esta p\\u00e1gina \\u00e0s suas [[Special:Watchlist|p\\u00e1ginas vigiadas]]\",\"discussiontools-target-comment-found-moved\":\"N\\u00e3o foi poss\\u00edvel encontrar este coment\\u00e1rio nesta p\\u00e1gina, mas ele exi